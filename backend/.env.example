# 酒店点评管家V3 - 环境变量配置
# 复制此文件为 .env 并修改配置

# 数据库（SQLite本地开发，PostgreSQL生产环境）
# SQLite: sqlite:///./hotel_review.db
# PostgreSQL: postgresql://user:password@localhost:5432/hotel_review
DATABASE_URL=sqlite:///./hotel_review.db

# JWT密钥（生产环境务必修改为随机字符串）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 数据加密密钥（32字节base64字符串）
ENCRYPTION_KEY=change-me-encryption-key-32bytes!!

# AI配置
AI_API_KEY=sk-your-api-key
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat

# 浏览器自动化
BROWSER_HEADLESS=true
BROWSER_POOL_SIZE=3
